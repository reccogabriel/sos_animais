# Modelo de configuração do SOS Animais de Olímpia.
#
# Como usar:
# 1. Copie este arquivo para um novo arquivo chamado .env na raiz do projeto.
# 2. Preencha os valores abaixo.
# 3. Nunca envie o .env para o GitHub (ele já está no .gitignore).
#
# Este arquivo não contém valores reais e pode ser versionado.

# Chave secreta do Django. Obrigatória: sem ela o sistema não inicia.
# Gere uma chave nova com o comando:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Modo de depuração. Use True apenas no seu computador.
# Se a linha ficar vazia ou for removida, o valor é False.
DEBUG=False

# Endereços pelos quais o sistema pode ser acessado, separados por vírgula.
# No computador local: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional. Origens HTTPS confiáveis para formulários, separadas por vírgula.
# Só é necessário quando o sistema for publicado em um domínio.
# Exemplo: https://sos-animais.exemplo.org
CSRF_TRUSTED_ORIGINS=
