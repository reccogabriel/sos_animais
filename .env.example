# Modelo de configuração do SOS Animais de Olímpia.
#
# Como usar:
# 1. Copie este arquivo para .env na raiz do projeto.
# 2. Preencha os valores abaixo para o seu ambiente.
# 3. Nunca envie o .env para o GitHub — ele já está no .gitignore.
#
# Este arquivo não contém valores reais e pode ser versionado.

# =============================================================================
# Variáveis obrigatórias em todos os ambientes
# =============================================================================

# Chave secreta do Django. Obrigatória: sem ela o sistema não inicia.
# Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Use chaves diferentes em desenvolvimento, preview e produção.
SECRET_KEY=

# Modo de depuração.
# Desenvolvimento local: True
# Preview (Vercel) e produção: False (nunca True em ambiente público)
DEBUG=False

# Hosts aceitos pelo Django, separados por vírgula.
# Desenvolvimento local:  localhost,127.0.0.1
# Produção (Vercel):      <seu-projeto>.vercel.app
# Preview (Vercel): configure explicitamente o hostname do preview.
# Este projeto nao adiciona VERCEL_URL automaticamente a ALLOWED_HOSTS.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens HTTPS confiáveis para formulários (CSRF), separadas por vírgula.
# Necessário em produção e preview quando acessado via HTTPS.
# Produção:  https://<seu-projeto>.vercel.app
# Preview:   o Vercel gera URLs únicas por deploy; configure conforme necessário.
CSRF_TRUSTED_ORIGINS=

# =============================================================================
# Banco de dados
# =============================================================================
# Desenvolvimento local: deixe vazio — SQLite é usado automaticamente.
# Preview (Vercel):      NÃO aponte para o banco de produção. Use um banco
#                        de preview separado ou deixe em branco (SQLite não
#                        funciona em produção no Vercel, mas builds de preview
#                        que não precisam de banco real podem omitir).
# Produção (Vercel):     Connection string do Neon Free.
#
# Formato Neon:
#   postgresql://usuario:senha@ep-xxx.regiao.aws.neon.tech/neondb?sslmode=require
#
# NUNCA envie esta variável para o GitHub.
# Configure apenas via painel do Vercel (Settings > Environment Variables),
# restringindo o escopo ao ambiente "Production".
DATABASE_URL=

# =============================================================================
# Script de criação do usuário demonstrativo
# (usado apenas por scripts/criar_usuario_demo.py, uma única vez)
# =============================================================================
# Senha do usuário "demo". Execute o script manualmente após migrar o banco.
# Não precisa estar no ambiente de produção após a criação.
DEMO_PASSWORD=
